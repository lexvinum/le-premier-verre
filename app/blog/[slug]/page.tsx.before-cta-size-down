import Link from "next/link";
import { notFound } from "next/navigation";
import type { SanityImageSource } from "@sanity/image-url";
import { PortableText } from "@portabletext/react";
import type { PortableTextBlock } from "@portabletext/types";

import { client } from "@/sanity/lib/client";
import { urlFor } from "@/sanity/lib/image";
import { articleBySlugQuery } from "@/sanity/lib/queries";

export const revalidate = 60;

type WinePreview = {
  _id: string;
  name: string;
  slug: string;
  vintage?: number;
  color?: string;
  bottleImage?: SanityImageSource;
  approxPrice?: number;
  oneLiner?: string;
  producer?: {
    _id: string;
    name: string;
    slug: string;
  };
};

type Article = {
  title: string;
  excerpt?: string;
  content?: PortableTextBlock[] | string;
  category?: string;
  author?: string;
  coverImage?: SanityImageSource;
  tags?: string[];
  tagsJson?: string;
  publishedAt?: string;
  _createdAt?: string;
  relatedWines?: WinePreview[];
};

function formatDate(value?: string) {
  if (!value) return null;

  return new Intl.DateTimeFormat("fr-CA", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(value));
}

function getBlockText(block: PortableTextBlock) {
  if (!("children" in block) || !Array.isArray(block.children)) return "";

  return block.children
    .map((child) =>
      "text" in child && typeof child.text === "string" ? child.text : ""
    )
    .join("")
    .trim();
}

function parseTags(article: Article) {
  if (Array.isArray(article.tags)) return article.tags;

  if (!article.tagsJson) return [];

  try {
    const parsed = JSON.parse(article.tagsJson);

    return Array.isArray(parsed)
      ? parsed.filter((item): item is string => typeof item === "string")
      : [];
  } catch {
    return [];
  }
}

export default async function ArticlePage({
  params,
}: {
  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;

  const article = await client.fetch<Article | null>(
    articleBySlugQuery,
    { slug }
  );

  if (!article) notFound();

  const imageSrc = article.coverImage
    ? urlFor(article.coverImage)
        .width(2000)
        .height(1400)
        .fit("crop")
        .url()
    : null;

  const tags = parseTags(article);

  const legacyParagraphs =
    typeof article.content === "string"
      ? article.content
          .split(/\n{2,}/)
          .map((paragraph) => paragraph.trim())
          .filter(Boolean)
      : [];

  const portableContent = Array.isArray(article.content)
    ? article.content
    : [];

  const wineSectionStart = portableContent.findIndex(
    (block) =>
      getBlockText(block).toLowerCase() ===
      "six bouteilles pour commencer"
  );

  const wineSectionEnd = portableContent.findIndex(
    (block, index) =>
      index > wineSectionStart &&
      getBlockText(block).toLowerCase() ===
        "une bouteille que tu n’aimes pas, ça compte aussi"
  );

  const contentBeforeWines =
    wineSectionStart >= 0
      ? portableContent.slice(0, wineSectionStart)
      : portableContent;

  const contentAfterWines =
    wineSectionStart >= 0 && wineSectionEnd >= 0
      ? portableContent.slice(wineSectionEnd)
      : [];

  const wines = article.relatedWines || [];

  return (
    <main className="min-h-screen bg-[var(--lpv-paper)] text-[var(--lpv-ink)]">
      <article className="pb-24">
        <div className="lpv-container pt-8 md:pt-10">
          <Link href="/blog" className="lpv-text-link">
            <span>←</span> Retour au journal
          </Link>
        </div>

        <header className="lpv-container grid gap-12 border-b border-[var(--lpv-line)] pb-16 pt-10 md:pb-24 md:pt-16 lg:grid-cols-[0.82fr_1.18fr]">
          <div className="lg:sticky lg:top-24 lg:self-start">
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              {article.category || "Article"}
            </p>

            <h1 className="lpv-display mt-7 text-[clamp(4.4rem,8vw,8.5rem)] leading-[0.84]">
              {article.title}
            </h1>

            {article.excerpt ? (
              <p className="mt-8 max-w-lg text-lg leading-8 text-[var(--lpv-muted)]">
                {article.excerpt}
              </p>
            ) : null}

            <div className="mt-10 flex flex-wrap gap-4 border-t border-[var(--lpv-line)] pt-7 text-xs uppercase tracking-[0.16em] text-[var(--lpv-muted)]">
              {article.author ? <span>{article.author}</span> : null}

              {formatDate(article.publishedAt || article._createdAt) ? (
                <span>
                  · {formatDate(article.publishedAt || article._createdAt)}
                </span>
              ) : null}
            </div>
          </div>

          <div className="overflow-hidden bg-[var(--lpv-paper-light)]">
            {imageSrc ? (
              <img
                src={imageSrc}
                alt={article.title}
                className="min-h-[620px] w-full object-cover md:min-h-[780px]"
              />
            ) : (
              <div className="flex min-h-[620px] items-center justify-center">
                <p className="text-sm text-[var(--lpv-muted)]">
                  Image à ajouter dans Sanity.
                </p>
              </div>
            )}
          </div>
        </header>

        <section className="lpv-container grid gap-10 border-b border-[var(--lpv-line)] py-16 md:grid-cols-[0.3fr_0.7fr] md:py-24">
          <div>
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              Le journal
            </p>

            <h2 className="lpv-display mt-6 text-5xl leading-[0.9] md:text-6xl">
              L’article.
            </h2>
          </div>

          {portableContent.length > 0 ? (
            <div className="max-w-4xl">
              <PortableText
                value={contentBeforeWines}
                components={{
                  block: {
                    normal: ({ children, value }) => {
                      const rawText = value.children
                        ?.map((child) =>
                          child._type === "span" ? child.text : ""
                        )
                        .join("")
                        .trim();

                      const isCTA = rawText?.startsWith("→");
                      const isPrimaryCTA =
                        rawText?.toLowerCase().includes("trouver une bouteille") ||
                        rawText?.toLowerCase().includes("trouver ma bouteille");

                      if (isCTA && isPrimaryCTA) {
                        return (
                          <div className="my-14 max-w-[46rem]">
                            <div className="group bg-[var(--lpv-ink)] px-7 py-7 text-[var(--lpv-paper)] md:px-9 md:py-9">
                              <p className="lpv-kicker text-[var(--lpv-paper)]/65">
                                Ce soir
                              </p>

                              <div className="mt-4 flex items-end justify-between gap-8">
                                <div className="lpv-display max-w-xl text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.9]">
                                  {children}
                                </div>

                                <span
                                  aria-hidden="true"
                                  className="mb-1 shrink-0 text-3xl transition-transform group-hover:translate-x-1"
                                >
                                  →
                                </span>
                              </div>
                            </div>
                          </div>
                        );
                      }

                      if (isCTA) {
                        return (
                          <div className="my-8 max-w-[46rem]">
                            <div className="inline-flex items-center gap-3 border-b border-[var(--lpv-ink)] pb-2 text-lg font-medium md:text-xl">
                              {children}
                            </div>
                          </div>
                        );
                      }

                      return (
                        <p className="mb-7 max-w-[46rem] text-[1.08rem] leading-[1.9] text-[var(--lpv-ink)] md:text-[1.14rem]">
                          {children}
                        </p>
                      );
                    },

                    h2: ({ children }) => (
                      <div className="mb-9 mt-20 grid border-t border-[var(--lpv-line)] pt-5 md:mt-28 md:grid-cols-[4rem_1fr] md:gap-5">
                        <span className="hidden text-xs tabular-nums tracking-[0.14em] text-[var(--lpv-cocoa)] md:block">
                          §
                        </span>
                        <h2 className="lpv-display max-w-3xl text-[clamp(3rem,6vw,5.5rem)] leading-[0.9]">
                          {children}
                        </h2>
                      </div>
                    ),

                    h3: ({ children }) => (
                      <h3 className="mb-5 mt-12 max-w-2xl text-2xl font-medium leading-tight md:text-3xl">
                        {children}
                      </h3>
                    ),

                    blockquote: ({ children, value }) => {
                      const rawText = value.children
                        ?.map((child) =>
                          child._type === "span" ? child.text : ""
                        )
                        .join("")
                        .trim();

                      if (rawText === "OCCASION + STYLE + BUDGET.") {
                        return (
                          <div className="my-14 border-y border-[var(--lpv-ink)] py-10 md:my-20 md:py-14">
                            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                              Le réflexe à retenir
                            </p>

                            <p className="lpv-display mt-5 max-w-4xl text-[clamp(3rem,7vw,6.5rem)] leading-[0.84]">
                              Occasion
                              <span className="mx-3 text-[var(--lpv-cocoa)]">+</span>
                              Style
                              <span className="mx-3 text-[var(--lpv-cocoa)]">+</span>
                              Budget
                            </p>
                          </div>
                        );
                      }

                      return (
                        <div className="my-10 max-w-[42rem] md:my-14">
                          <p className="text-xl italic leading-[1.65] text-[var(--lpv-ink)] md:text-2xl">
                            {children}
                          </p>
                        </div>
                      );
                    },
                  },

                  marks: {
                    link: ({ children, value }) => {
                      const href = value?.href || "#";
                      const internal = href.startsWith("/");

                      return (
                        <Link
                          href={href}
                          className="font-medium underline decoration-[var(--lpv-cocoa)] decoration-1 underline-offset-4 transition-opacity hover:opacity-60"
                          {...(!internal
                            ? {
                                target: "_blank",
                                rel: "noopener noreferrer",
                              }
                            : {})}
                        >
                          {children}
                        </Link>
                      );
                    },
                  },

                  list: {
                    bullet: ({ children }) => (
                      <ul className="my-10 grid gap-3 md:grid-cols-3">
                        {children}
                      </ul>
                    ),
                  },

                  listItem: {
                    bullet: ({ children }) => (
                      <li className="border-t border-[var(--lpv-line)] pt-4 text-lg leading-7">
                        {children}
                      </li>
                    ),
                  },
                }}
              />

              {wineSectionStart >= 0 ? (
                <section className="my-24 md:my-32">
                  <div className="mb-10 border-t border-[var(--lpv-line)] pt-8">
                    <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                      Pour commencer
                    </p>

                    <h2 className="lpv-display mt-5 max-w-4xl text-[clamp(3rem,6vw,5.5rem)] leading-[0.9]">
                      Six bouteilles pour commencer.
                    </h2>

                    <p className="mt-7 max-w-2xl text-lg leading-8 text-[var(--lpv-muted)]">
                      Six styles assez différents pour commencer à voir ce que
                      tu aimes — et ce que tu peux très bien laisser aux autres.
                    </p>
                  </div>

                  {wines.length > 0 ? (
                    <div className="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
                      {wines.map((wine) => {
                        const bottleSrc = wine.bottleImage
                          ? urlFor(wine.bottleImage)
                              .width(700)
                              .height(900)
                              .fit("max")
                              .url()
                          : null;

                        return (
                          <Link
                            href={`/vins/${wine.slug}`}
                            key={wine._id}
                            className="group block"
                          >
                            <div className="relative flex aspect-[4/5] items-center justify-center overflow-hidden bg-[var(--lpv-paper-light)] p-8">
                              {bottleSrc ? (
                                <img
                                  src={bottleSrc}
                                  alt={wine.name}
                                  className="h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]"
                                />
                              ) : (
                                <div className="flex h-full w-full items-center justify-center border border-dashed border-[var(--lpv-line)]">
                                  <span className="text-sm text-[var(--lpv-muted)]">
                                    Photo à venir
                                  </span>
                                </div>
                              )}

                              {wine.approxPrice ? (
                                <div className="absolute right-3 top-3 rounded-full bg-[var(--lpv-paper)] px-3 py-2 text-xs">
                                  {wine.approxPrice.toFixed(2).replace(".", ",")} $
                                </div>
                              ) : null}
                            </div>

                            <div className="border-b border-[var(--lpv-line)] pb-6 pt-5">
                              {wine.producer?.name ? (
                                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                                  {wine.producer.name}
                                </p>
                              ) : null}

                              <h3 className="mt-2 text-xl font-medium leading-tight">
                                {wine.name}
                              </h3>

                              {wine.oneLiner ? (
                                <p className="mt-3 line-clamp-2 text-sm leading-6 text-[var(--lpv-muted)]">
                                  {wine.oneLiner}
                                </p>
                              ) : null}

                              <span className="mt-5 inline-block border-b border-[var(--lpv-ink)] pb-1 text-sm">
                                La fiche <span className="ml-1">↗</span>
                              </span>
                            </div>
                          </Link>
                        );
                      })}
                    </div>
                  ) : (
                    <p className="text-[var(--lpv-muted)]">
                      Les bouteilles liées seront bientôt affichées ici.
                    </p>
                  )}
                </section>
              ) : null}

              {contentAfterWines.length > 0 ? (
                <PortableText
                  value={contentAfterWines}
                  components={{
                    block: {
                      normal: ({ children, value }) => {
                        const rawText = value.children
                          ?.map((child) =>
                            child._type === "span" ? child.text : ""
                          )
                          .join("")
                          .trim();

                        const isCTA = rawText?.startsWith("→");
                        const lowerText = rawText?.toLowerCase() || "";

                        const isNewsletter =
                          lowerText.includes("s’inscrire à l’infolettre") ||
                          lowerText.includes("s'inscrire à l'infolettre");

                        const isPrimaryCTA =
                          lowerText.includes("trouver une bouteille") ||
                          lowerText.includes("trouver ma bouteille");

                        const isPersonalCTA =
                          lowerText.includes("ma cave") ||
                          lowerText.includes("mon carnet");

                        if (isNewsletter) {
                          return (
                            <div className="my-16 bg-[var(--lpv-paper-light)] px-7 py-10 md:my-20 md:px-10 md:py-12">
                              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                                L’infolettre
                              </p>

                              <div className="mt-5 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
                                <div>
                                  <p className="lpv-display max-w-2xl text-[clamp(2.8rem,5vw,4.8rem)] leading-[0.9]">
                                    On se reparle autour d’un verre?
                                  </p>

                                  <p className="mt-5 max-w-xl text-base leading-7 text-[var(--lpv-muted)]">
                                    Des bouteilles qu’on a aimées, des producteurs à connaître
                                    et quelques bonnes adresses. Pas tous les jours. Juste quand
                                    on a quelque chose de bon à partager.
                                  </p>
                                </div>

                                <div className="inline-flex w-fit items-center gap-4 bg-[var(--lpv-ink)] px-5 py-4 text-base font-medium text-[var(--lpv-paper)]">
                                  {children}
                                  <span aria-hidden="true">→</span>
                                </div>
                              </div>
                            </div>
                          );
                        }

                        if (isPrimaryCTA) {
                          return (
                            <div className="my-14 max-w-[46rem]">
                              <div className="group bg-[var(--lpv-ink)] px-7 py-7 text-[var(--lpv-paper)] md:px-9 md:py-9">
                                <p className="lpv-kicker text-[var(--lpv-paper)]/65">
                                  Ce soir
                                </p>

                                <div className="mt-4 flex items-end justify-between gap-8">
                                  <div className="lpv-display max-w-xl text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.9]">
                                    {children}
                                  </div>

                                  <span
                                    aria-hidden="true"
                                    className="mb-1 shrink-0 text-3xl transition-transform group-hover:translate-x-1"
                                  >
                                    →
                                  </span>
                                </div>
                              </div>
                            </div>
                          );
                        }

                        if (isPersonalCTA) {
                          return (
                            <div className="my-5 max-w-[46rem]">
                              <div className="group flex items-center justify-between gap-8 bg-[var(--lpv-paper-light)] px-6 py-5">
                                <div className="text-lg font-medium">
                                  {children}
                                </div>

                                <span
                                  aria-hidden="true"
                                  className="text-xl text-[var(--lpv-cocoa)] transition-transform group-hover:translate-x-1"
                                >
                                  →
                                </span>
                              </div>
                            </div>
                          );
                        }

                        if (isCTA) {
                          return (
                            <div className="my-8 max-w-[46rem]">
                              <div className="inline-flex items-center gap-3 border-b border-[var(--lpv-ink)] pb-2 text-lg font-medium">
                                {children}
                              </div>
                            </div>
                          );
                        }

                        return (
                          <p className="mb-7 max-w-[46rem] text-[1.08rem] leading-[1.9] md:text-[1.14rem]">
                            {children}
                          </p>
                        );
                      },

                      h2: ({ children }) => (
                        <div className="mb-9 mt-20 grid border-t border-[var(--lpv-line)] pt-5 md:mt-28 md:grid-cols-[4rem_1fr] md:gap-5">
                          <span className="hidden text-xs tabular-nums tracking-[0.14em] text-[var(--lpv-cocoa)] md:block">
                            §
                          </span>
                          <h2 className="lpv-display max-w-3xl text-[clamp(3rem,6vw,5.5rem)] leading-[0.9]">
                            {children}
                          </h2>
                        </div>
                      ),

                      blockquote: ({ children, value }) => {
                        const rawText = value.children
                          ?.map((child) =>
                            child._type === "span" ? child.text : ""
                          )
                          .join("")
                          .trim();

                        if (rawText === "OCCASION + STYLE + BUDGET.") {
                          return (
                            <div className="my-14 border-y border-[var(--lpv-ink)] py-10 md:my-20 md:py-14">
                              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                                Le réflexe à retenir
                              </p>

                              <p className="lpv-display mt-5 text-[clamp(3rem,7vw,6.5rem)] leading-[0.84]">
                                Occasion + Style + Budget
                              </p>
                            </div>
                          );
                        }

                        return (
                          <div className="my-10 max-w-[42rem] md:my-14">
                            <p className="text-xl italic leading-[1.65] text-[var(--lpv-ink)] md:text-2xl">
                              {children}
                            </p>
                          </div>
                        );
                      },
                    },

                    marks: {
                      link: ({ children, value }) => (
                        <Link
                          href={value?.href || "#"}
                          className="font-medium underline decoration-[var(--lpv-cocoa)] underline-offset-4"
                        >
                          {children}
                        </Link>
                      ),
                    },

                    list: {
                      bullet: ({ children }) => (
                        <ul className="my-10 grid gap-3 md:grid-cols-3">
                          {children}
                        </ul>
                      ),
                    },

                    listItem: {
                      bullet: ({ children }) => (
                        <li className="border-t border-[var(--lpv-line)] pt-4 text-lg">
                          {children}
                        </li>
                      ),
                    },
                  }}
                />
              ) : null}
            </div>
          ) : legacyParagraphs.length > 0 ? (
            <div className="lpv-prose max-w-3xl">
              {legacyParagraphs.map((paragraph, index) => (
                <p key={`${index}-${paragraph.slice(0, 24)}`}>
                  {paragraph}
                </p>
              ))}
            </div>
          ) : (
            <p className="text-base leading-8 text-[var(--lpv-muted)]">
              Le contenu détaillé de cet article est en préparation.
            </p>
          )}
        </section>

        {tags.length > 0 ? (
          <section className="lpv-container border-b border-[var(--lpv-line)] py-10 md:py-12">
            <div className="flex flex-col gap-5 md:flex-row md:items-center md:gap-8">
              <p className="lpv-kicker shrink-0 text-[var(--lpv-cocoa)]">
                Dans cet article
              </p>

              <div className="flex flex-wrap gap-x-3 gap-y-2">
                {tags.map((tag, index) => (
                  <span
                    key={tag}
                    className="text-base text-[var(--lpv-muted)]"
                  >
                    {tag}
                    {index < tags.length - 1 ? (
                      <span className="ml-3 text-[var(--lpv-line)]">•</span>
                    ) : null}
                  </span>
                ))}
              </div>
            </div>
          </section>
        ) : null}

        <section className="lpv-container py-16 md:py-24">
          <div className="border-t border-[var(--lpv-line)] pt-8">
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              Continuer
            </p>

            <Link href="/blog" className="group mt-6 block">
              <h2 className="lpv-display max-w-4xl text-5xl leading-[0.9] transition-opacity group-hover:opacity-60 md:text-7xl">
                Encore un verre?
              </h2>

              <p className="mt-6 max-w-xl text-lg leading-8 text-[var(--lpv-muted)]">
                D’autres bouteilles, des producteurs, des endroits et quelques
                détours pour continuer à découvrir le vin sans en faire un examen.
              </p>

              <span className="lpv-text-link mt-8">
                Continuer dans le journal <span>→</span>
              </span>
            </Link>
          </div>
        </section>
      </article>
    </main>
  );
}
